# Kopieer naar .env en pas aan indien gewenst. Geen van deze variabelen is
# een echt beveiligingsmechanisme — dit is een 100% client-side app, dus de
# waarde komt gewoon mee in de gepubliceerde bundel voor wie er echt naar
# zoekt. Zie de README voor uitleg.

# Wachtwoord voor het Admin-gedeelte in Instellingen (prototype-afscherming,
# bedoeld om verkeerde klikken te voorkomen, niet om data te beveiligen).
# Standaard 'ww' als deze variabele niet gezet is.
VITE_ADMIN_PASSWORD=ww
